# Credenciais da API Consulta CPF (Loja SERPRO > Área do cliente)
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# Opcional: sobrescreve o endpoint (ex.: versão diferente da API contratada)
# SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v1/cpf

# Opcional: conexão com o banco de clientes (formato SQLAlchemy)
# DB_URL=postgresql+psycopg2://usuario:senha@host:5432/banco

# Serviço HTTP (python -m cpf_checker.server): chave exigida no cabeçalho X-API-Key
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CPF_API_KEY=
